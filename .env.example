# =============================================================================
# PowrBridge PM — Environment Variables
# Copy to .env.local and fill in real values. Never commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PowrBridge PM

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/powrbridge_pm?schema=public
# Optional: direct URL for migrations when using connection pooling (e.g. PgBouncer)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/powrbridge_pm?schema=public

# -----------------------------------------------------------------------------
# Redis (cache, pub/sub, rate limiting, BullMQ)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=powrbridge:

# -----------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth v5)
# Generate: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_URL=http://localhost:3000

# Credentials / OAuth providers (enable as needed)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# JWT / session
AUTH_SESSION_MAX_AGE=2592000
# Seconds; default 30 days

# -----------------------------------------------------------------------------
# File Storage (choose one or both)
# -----------------------------------------------------------------------------
# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=powrbridge-attachments
AWS_S3_ENDPOINT=
# Optional custom endpoint (MinIO, R2, etc.)
NEXT_PUBLIC_CDN_URL=

# Cloudinary (alternative)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=powrbridge

# -----------------------------------------------------------------------------
# Stripe Billing
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# -----------------------------------------------------------------------------
# Real-time / WebSockets
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WS_URL=http://localhost:3001
SOCKET_IO_PATH=/socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Email (transactional — invites, notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=PowrBridge <noreply@powrbridge.app>
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Observability & Rate Limiting
# -----------------------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
